---fetch
select cast(AVG(ffs.funding) as decimal(10,2)) as avg_funding, 
fvc.funding_limit, ffs.vc_id, fvc.vc_name
from fs_funded_startups ffs join fs_venture_capitalist fvc
on fvc.vc_id = ffs.vc_id
group by fvc.funding_limit, ffs.vc_id, fvc.vc_name
having avg(ffs.funding) > fvc.funding_limit
order by avg_funding desc

