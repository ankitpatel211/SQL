-- create
CREATE TABLE fs_funded_startups (
  startup_id varchar(10),
  startup_name varchar(15),
  vc_id varchar(10),
  funding decimal(10,2)
);

CREATE TABLE fs_venture_capitalist (
  vc_id varchar(10),
  vc_name varchar(10),
  funding_limit decimal(10,2)
);

