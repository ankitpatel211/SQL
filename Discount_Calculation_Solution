---fetch
select storeid, productname, category, soldunits, [description], case when [description] like '%[0-9]%' then 
  cast(substring([description], CHARINDEX('[', [description]) + 1, 
  CHARINDEX('%', [description]) - CHARINDEX('[', [description]) - 1) as decimal(10,2)) / 100
else 0 end as discount from cgdc_sales;
