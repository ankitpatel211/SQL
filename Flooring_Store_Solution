--Create
Create Table fr_customers(
   customer_id int,
   full_name varchar(10),
   [location] varchar(10)
);

Create Table fr_orders(
  order_id int,
  customer_id int,
  product_id int,
  quantity int
);

Create Table fr_products(
  product_id int,
  product_info varchar(10)
);

