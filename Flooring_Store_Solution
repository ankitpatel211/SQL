--Fetch
SELECT fc.customer_id,
       substring(fc.full_name, 1, charindex(' ', fc.full_name) - 1) as first_name,
       substring(fc.full_name, charindex(' ', fc.full_name) + 1, len(fc.full_name)) as last_name,
       fc.[location],
       fo.order_id,
       substring(fp.product_info, 1, charindex(',', fp.product_info) - 1) as product_type,
       substring(fp.product_info, charindex(',', fp.product_info) + 1, len(fp.product_info)) as product_color,
       fp.product_id,
       fo.quantity
FROM fr_customers fc JOIN fr_orders fo
ON fo.customer_id = fc.customer_id JOIN fr_products fp
ON fp.product_id = fo.product_id
ORDER BY fo.order_id asc










