-- create
CREATE TABLE so_planet (
  id int,
  [name] varchar(20),
  star_id int,
  [type] varchar(20),
  distance decimal(10,2)
);

CREATE TABLE so_star (
  id int,
  [name] varchar(20),
  color varchar(20),
  [type] varchar(20),
  distance decimal(10,2)
)

