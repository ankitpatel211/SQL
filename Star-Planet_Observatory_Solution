---fetch
select ss.[name] as star_name, ss.color as star_color,ss.[type] as star_type, 
sp.[name] as planet_name, sp.[type] as planet_type, 
ss.distance as distance_star_earth, sp.distance as distance_planet_star
from so_star ss join so_planet sp
on ss.id = sp.star_id

