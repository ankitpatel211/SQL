---fetch
SELECT mee.experiment_id, mee.material_id, mee.experiment_date,
       mee.experiment_results, mem.material_name, mem.material_type
FROM me_experiments mee LEFT OUTER JOIN me_materials mem
ON mee.material_id = mem.material_id 
ORDER BY mee.experiment_id asc
