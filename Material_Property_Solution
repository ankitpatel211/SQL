-- create
CREATE TABLE me_experiments (
  experiment_id int,
  material_id int,
  experiment_date date,
  experiment_results decimal(10,1)
);

CREATE TABLE me_materials (
  material_id int,
  material_name varchar(20),
  material_type varchar(20)
);

