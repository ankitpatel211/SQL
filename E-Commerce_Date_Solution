---fetch
SELECT ecdp.category,
     CASE DATENAME(weekday, CONVERT(datetime, ecdo.order_date, 101))
        WHEN "Saturday" THEN 1 
        WHEN "Sunday" THEN 1
        ELSE 0 
     END as is_weekend, ecdo.order_date, ecdp.product_name, ecdo.user_id
FROM ecom_dt_orders ecdo
JOIN ecom_dt_products ecdp
on ecdp.product_id = ecdo.product_id
where ecdo.order_date like '%[0-1][0-9]/[0-3][0-9]/[1-2][0-9][0-9][0-9]%'
ORDER BY ecdp.category asc, ecdo.order_date desc

