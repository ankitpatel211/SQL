-- create
CREATE TABLE ecom_dt_orders (
  order_id varchar(10),
  product_id varchar(15),
  user_id varchar(10),
  order_date varchar(10)
);

CREATE TABLE ecom_dt_products (
  product_id varchar(10),
  product_name varchar(10),
  category varchar(20)
);

