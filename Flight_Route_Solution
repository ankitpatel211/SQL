--Create
Create Table ba_flights(
   flight_id int,
   origin_airport varchar(30),
   destination_airport varchar(30),
   plane_id int
);

Create Table ba_airports(
  airport_id varchar(30),
  airport_name varchar(30)
);

Create Table ba_planes(
  plane_id int,
  plane_model varchar(20)
);

