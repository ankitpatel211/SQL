--Fetch
SELECT baf.flight_id, len(trim(oa.airport_name)) as origin_airport_name,
len(trim(da.airport_name)) as destination_airport_name, 
len(trim(bap.plane_model)) as plane_model
FROM ba_flights baf join ba_airports oa
on baf.origin_airport = oa.airport_id
join ba_airports da
on baf.destination_airport = da.airport_id
join ba_planes bap
on baf.plane_id = bap.plane_id
